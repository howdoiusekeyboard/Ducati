# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google API Configuration (for Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Optional OpenAI Configuration (will use environment-specific defaults if not set)
# OPENAI_MODEL=gpt-4.1
# OPENAI_TEMPERATURE=0.7
# OPENAI_MAX_TOKENS=150

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Application Configuration
NEXT_PUBLIC_APP_NAME=Ducati

# Environment Configuration
# NODE_ENV=development
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Firebase Admin SDK service account (server-side ID-token verification + Firestore reads)
# Generate via Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# Then paste the entire JSON file contents (single line) as the value.
# Already configured on Vercel Production + Development envs.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nFAKE_PLACEHOLDER\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"}