{
  "name": "openai-firebase-chatbot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=24.15.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:firebase": "next build",
    "check-env": "bun scripts/check-env.js",
    "check-env:fix": "bun scripts/check-env.js --fix",
    "test": "bun jest",
    "test:watch": "bun jest --watch",
    "test:coverage": "bun jest --coverage",
    "test:unit": "bun jest tests/unit",
    "test:integration": "bun jest tests/integration",
    "test:verbose": "bun jest --verbose",
    "predev": "bun scripts/check-env.js",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "bun run build:firebase && firebase deploy",
    "deploy:hosting": "bun run build:firebase && firebase deploy --only hosting",
    "deploy:apphosting": "firebase apphosting:backends:create --location=us-central1",
    "upload-media": "bun scripts/upload-media.js"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@tailwindcss/postcss": "^4.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "firebaseui": "^6.1.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.4",
    "postcss": "^8.5.13",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4"
  },
  "overrides": {
    "firebaseui": {
      "firebase": "$firebase"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.3",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-jest": "^30.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.0"
  },
  "trustedDependencies": [
    "@google/genai",
    "@tailwindcss/oxide",
    "protobufjs"
  ]
}
